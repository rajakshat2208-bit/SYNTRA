# Model provider: "anthropic" for real AI execution, "fixture" for local testing (no API calls)
SYNTRA_MODEL_PROVIDER=fixture

# Required only when SYNTRA_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
SYNTRA_MODEL_ID=claude-sonnet-4-5-20250929

# SQLite file path
SYNTRA_DB_PATH=syntra.db

# Comma-separated allowed origins for CORS
SYNTRA_CORS_ORIGINS=http://localhost:5173
